{
  "expo": {
    "name": "Valto",
    "slug": "valto",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "valto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renkakpo.valto.app",
      "appleTeamId": "2Z64XRNQZU",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#9C7855"
      },
      "package": "com.renkakpo.valto.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#9C7855",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#171310"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "valto",
          "organization": "renekakpo",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "includeNativeSources": false
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withAndroidBackupRules",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "./plugins/withoutApsEnvironment",
      "./plugins/withoutStatusBarColor",
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.notifications.** { *; }"
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/d3276823-de41-47a7-affa-4ae3fc8e1391"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3276823-de41-47a7-affa-4ae3fc8e1391"
      }
    },
    "owner": "related-projects"
  }
}
